# Docker images
DOCKER_USERNAME=CHANGE_ME
FRONTEND_IMAGE_TAG=latest

# AWS RDS
RDS_HOSTNAME=CHANGE_ME
RDS_PORT=5432
RDS_DB_NAME=bubli
RDS_USERNAME=bubli
RDS_PASSWORD=CHANGE_ME

# Storage
STORAGE_TYPE=s3
S3_BUCKET_NAME=CHANGE_ME

# AI providers: bedrock-converse / none, bedrock-titan / ollama / none
AI_CHAT_PROVIDER=bedrock-converse
AI_EMBEDDING_PROVIDER=bedrock-titan
AI_EMBEDDING_DIMENSIONS=1024
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
BEDROCK_CHAT_MODEL_ID=apac.anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Application secrets
JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME
GOOGLE_OAUTH_REDIRECT_URI=https://my-bubli.kro.kr/login/oauth2/code/google
GOOGLE_CALENDAR_CLIENT_ID=CHANGE_ME
GOOGLE_CALENDAR_CLIENT_SECRET=CHANGE_ME
GOOGLE_CALENDAR_REDIRECT_URI=https://my-bubli.kro.kr/api/calendar/google/callback
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME
LIVEKIT_SERVER_URL=CHANGE_ME
CORS_ALLOWED_ORIGIN_PATTERNS=https://my-bubli.kro.kr,tauri://localhost,http://tauri.localhost,http://localhost:3000,http://localhost:5173,http://localhost:1420
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# HTTPS config. Use nginx.http-only.conf only while issuing the first certificate.
NGINX_CONFIG_PATH=./infra/nginx/nginx.conf
