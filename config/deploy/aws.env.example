# Personal AWS production reference.
# GitHub Actions generates .env.aws on EC2 during each AWS deployment.
# Never put real secrets in this tracked file.

# Docker images
DOCKER_USERNAME=jerygen
IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest

# AWS RDS values are generated automatically at deployment from the RDS-managed
# Secrets Manager credential. Do not place the RDS password in this template.
RDS_HOSTNAME=
RDS_PORT=
RDS_DB_NAME=
RDS_USERNAME=
RDS_PASSWORD=

# Storage
STORAGE_TYPE=s3
S3_BUCKET_NAME=bubli-storage-my-aws

# AI providers: bedrock-converse / none, bedrock-titan / ollama / none
AI_CHAT_PROVIDER=bedrock-converse
AI_EMBEDDING_PROVIDER=bedrock-titan
AI_EMBEDDING_DIMENSIONS=1024
AWS_REGION=ap-northeast-2
# EC2 Instance Profile supplies Bedrock and S3 credentials. Do not place AWS access keys here.
BEDROCK_CHAT_MODEL_ID=apac.anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# JWT and Grafana password are generated on the first deployment and saved in
# AWS Secrets Manager. Google and LiveKit values come from GitHub Actions secrets.
JWT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://my-bubli.kro.kr/login/oauth2/code/google
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://my-bubli.kro.kr/api/calendar/google/callback
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SERVER_URL=
CORS_ALLOWED_ORIGIN_PATTERNS=https://my-bubli.kro.kr,tauri://localhost,http://tauri.localhost,http://localhost:3000,http://localhost:5173,http://localhost:1420
# Optional error reporting. Leave SENTRY_DSN empty to disable Sentry.
SENTRY_DSN=
SENTRY_SEND_DEFAULT_PII=false
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
LETSENCRYPT_EMAIL=myksphone2001@gmail.com

# Use nginx.http-only.conf only while issuing the first Let's Encrypt certificate.
# Change to nginx.conf after the certificate is issued.
NGINX_CONFIG_PATH=./infra/nginx/nginx.http-only.conf
